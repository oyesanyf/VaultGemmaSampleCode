# ============================================================
# KEEP THESE FILES (NEGATIONS)
# ============================================================
# Keep README and documentation
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!LICENSE
!SECURITY.md

# Keep requirements
!requirements.txt

# Keep setup files
!setup.py
!pyproject.toml

# Keep example configs
!.env.example
!config.example.yaml

# Keep GitHub workflows
!.github/
!.github/**/*

# Keep test scripts
!test_model_queries.py
!*_tests.py

# Keep batch scripts
!*.bat
!run_*.bat

# Keep markdown docs
!*.md
!10_TEST_QUERIES.md
!TEST_QUERIES.md
